# Sourcing nvm.sh costs ~1.5s per shell, so it only loads on the first `nvm` call.
nvm() {
  unfunction nvm
  source "$NVM_DIR/nvm.sh" --no-use
  [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
  nvm "$@"
}

_nvm_find_up() {
  local dir=${1:-$PWD}
  while true; do
    [[ -f $dir/.nvmrc ]] && { REPLY=$dir/.nvmrc; return 0 }
    [[ $dir == / ]] && return 1
    dir=${dir:h}
  done
}

# Picks the newest installed version for numeric specs like v24, 22.15 or default.
_nvm_resolve() {
  local spec=$1
  [[ $spec == default && -f $NVM_DIR/alias/default ]] && spec=$(<$NVM_DIR/alias/default)
  spec=${spec#v}
  [[ $spec =~ '^[0-9]+(\.[0-9]+)*$' ]] || return 1
  local -a found=($NVM_DIR/versions/node/v${spec}(|.*)(N/n))
  (( $#found )) || return 1
  REPLY=${found[-1]:t}
}

_nvm_activate() {
  local dir=$NVM_DIR/versions/node/$1
  path=($dir/bin ${path:#*/nvm/versions/node/*/bin})
  export NVM_BIN=$dir/bin NVM_INC=$dir/include/node
}

autoload -U add-zsh-hook

load-nvmrc() {
  local spec rc
  if _nvm_find_up; then
    rc=$REPLY
    spec=${"$(<$rc)"//[[:space:]]/}
  elif [[ $1 == init ]] || _nvm_find_up $OLDPWD; then
    spec=default
  else
    return
  fi

  if _nvm_resolve $spec; then
    [[ -n ${path[(r)$NVM_DIR/versions/node/$REPLY/bin]} ]] && return
    _nvm_activate $REPLY
    [[ $1 == init && -z $rc ]] || echo "Now using node $REPLY"
  elif [[ -n $rc ]]; then
    nvm install
  else
    nvm use default
  fi
}

add-zsh-hook chpwd load-nvmrc
