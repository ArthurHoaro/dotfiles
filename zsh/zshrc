# Add a line break to Oh my ZSH prompt
prompt_end() {
  if [[ -n $CURRENT_BG ]]; then
      print -n " %{%k%F{$CURRENT_BG}%}$SEGMENT_SEPARATOR"
  else
      print -n "%{%k%}"
  fi

  print -n "%{%f%}"
  CURRENT_BG=''

  #Adds the new line and ➜ as the start character.
  printf "\n ➜";
}

# Agnoster's prompt_git runs ~8 git commands per prompt (~100ms); this gets the same info from one.
prompt_git() {
  (( $+commands[git] )) || return
  local line head oid ab dirty staged unstaged ref mode git_dir dir=$PWD
  local PL_BRANCH_CHAR=''
  local -a st
  st=("${(@f)$(command git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)}")
  [[ -n $st[1] ]] || return
  for line in $st; do
    case $line in
      '# branch.head '*) head=${line#\# branch.head } ;;
      '# branch.oid '*) oid=${line#\# branch.oid } ;;
      '# branch.ab '*) ab=${line#\# branch.ab } ;;
      [12u]' '*)
        dirty=1
        [[ ${line[3]} != . ]] && staged='✚'
        [[ ${line[4]} != . ]] && unstaged='±'
        ;;
      '? '*) dirty=1 ;;
    esac
  done

  if [[ $head != '(detached)' ]]; then
    ref="$PL_BRANCH_CHAR $head"
  elif ref=$(command git describe --exact-match --tags HEAD 2>/dev/null); then
    ref="◈ $ref"
  else
    ref="➦ ${oid[1,7]}"
  fi

  if [[ $AGNOSTER_GIT_BRANCH_STATUS == 'true' && -n $ab ]]; then
    local ahead=${${ab%% *}#+} behind=${${ab##* }#-}
    if (( ahead && behind )); then ref='⇅'" $head"
    elif (( ahead )); then ref='↱'" $head"
    elif (( behind )); then ref='↰'" $head"
    fi
  fi

  while [[ $dir != / && ! -e $dir/.git ]]; do dir=${dir:h}; done
  if [[ -f $dir/.git ]]; then
    git_dir=${$(<$dir/.git)#gitdir: }
    [[ $git_dir == /* ]] || git_dir=$dir/$git_dir
  else
    git_dir=$dir/.git
  fi
  if [[ -e $git_dir/BISECT_LOG ]]; then mode=" <B>"
  elif [[ -e $git_dir/MERGE_HEAD ]]; then mode=" >M<"
  elif [[ -e $git_dir/rebase || -e $git_dir/rebase-apply || -e $git_dir/rebase-merge ]]; then mode=" >R>"
  fi

  if [[ -n $dirty ]]; then
    prompt_segment "$AGNOSTER_GIT_DIRTY_BG" "$AGNOSTER_GIT_DIRTY_FG"
  else
    prompt_segment "$AGNOSTER_GIT_CLEAN_BG" "$AGNOSTER_GIT_CLEAN_FG"
  fi
  local flags="${unstaged}${staged}"
  echo -n "${ref//\%/%%}${flags:+ $flags}${mode}"
  [[ $AGNOSTER_GIT_INLINE == 'true' ]] && prompt_git_relative
}

